@article{nwokolo_artificial_2023,
	title = {The {Artificial} {Pancreas} and {Type} 1 {Diabetes}},
	volume = {108},
	issn = {0021-972X},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC10271231/},
	doi = {10.1210/clinem/dgad068},
	abstract = {Diabetes technologies represent a paradigm shift in type 1 diabetes care. Continuous subcutaneous insulin infusion (CSII) pumps and continuous glucose monitors (CGM) improve glycated hemoglobin (HbA1c) levels, enhance time in optimal glycemic range, limit severe hypoglycemia, and reduce diabetes distress. The artificial pancreas or closed-loop system connects these devices via a control algorithm programmed to maintain target glucose, partially relieving the person living with diabetes of this constant responsibility. Automating insulin delivery reduces the input required from those wearing the device, leading to better physiological and psychosocial outcomes. Hybrid closed-loop therapy systems, requiring user-initiated prandial insulin doses, are the most advanced closed-loop systems commercially available. Fully closed-loop systems, requiring no user-initiated insulin boluses, and dual hormone systems have been shown to be safe and efficacious in the research setting. Clinical adoption of closed-loop therapy remains in early stages despite recent technological advances. People living with diabetes, health care professionals, and regulatory agencies continue to navigate the complex path to equitable access. We review the available devices, evidence, clinical implications, and barriers regarding these innovatory technologies.},
	number = {7},
	urldate = {2026-05-20},
	journal = {The Journal of Clinical Endocrinology and Metabolism},
	author = {Nwokolo, Munachiso and Hovorka, Roman},
	month = feb,
	year = {2023},
	keywords = {artificial-pancreas},
	pages = {1614--1623},
	annote = {Pancreas artificial},
	file = {Texto completo:C\:\\Users\\Usuario\\Zotero\\storage\\JBC4QPVA\\Nwokolo y Hovorka - 2023 - The Artificial Pancreas and Type 1 Diabetes.pdf:application/pdf},
}

@article{rizos_continuous_2025,
	title = {Continuous {Glucose} {Monitoring} in {Type} 1 {Diabetes}, {Type} 2 {Diabetes}, and {Diabetes} {During} {Pregnancy}: {A} {Systematic} {Review} with {Meta}-{Analysis} of {Randomized} {Controlled} {Trials}},
	volume = {27},
	issn = {1520-9156},
	shorttitle = {Continuous {Glucose} {Monitoring} in {Type} 1 {Diabetes}, {Type} 2 {Diabetes}, and {Diabetes} {During} {Pregnancy}},
	url = {https://journals.sagepub.com/action/showAbstract},
	doi = {10.1089/dia.2024.0599},
	abstract = {Background:Continuous glucose monitoring (real-time CGM [RT-CGM] and retrospective [professional] CGM [non-RT-CGM]) is an emerging tool to assess glucose levels and variability. We performed a meta-analysis of randomized controlled trials (RCTs) to assess the effect of RT/non-RT-CGM on type 1 (T1D), type 2 (T2D), and diabetes in pregnancy (DiP) compared with self-monitoring of blood glucose (BGM).Methods:We searched PubMed/EMBASE/Cochrane Central Register of Controlled Trials until October 2024. The coprimary outcomes were the weighted mean change differences (WMCDs and absolute differences) from baseline in glycated hemoglobin (HbA1c) and in time in range (TIR\%), time below range (TBR\%), and time above range (TAR\%).Results:A total of 64 RCTs were analyzed: (1) RT-CGM/T1D: CGM was superior to BGM for HbA1c reduction (WMCD −0.24, 95\% confidence interval [CI]: −0.35; −0.14, I 2 = 71\%), decrease in TBR {\textless}70 mg/dL (WMCD −2.41, 95\% CI: −3.46; −1.35, I 2 = 96\%), decrease in TBR {\textless} 54 mg/dL (WMCD −1.18 95\% CI: −1.9; −0.47, I 2 = 97\%), decrease in TAR {\textgreater}180 mg/dL (WMCD −2.99, 95\% CI: −5.28; −0.71, I 2 = 92\%), decrease in TAR {\textgreater}250 mg/dL (WMCD −3.99, 95\% CI: −5.76; −2.21, I 2 = 92\%), and increase in TIR 70–180 mg/dL (WMCD 5.57, 95\% CI: 4.13; 7.01, I 2 = 84\%); (2) RT-CGM/T2D: CGM was superior to BGM for HbA1c reduction (WMCD −0.40, 95\% CI: −0.55; −0.24, I 2 = 52\%), decrease in TAR {\textgreater} 180 mg/dL (WMCD −6.32, 95\% CI: −9.87; −2.78, I 2 = 84\%), decrease in TAR {\textgreater} 250 mg/dL (WMCD −5.73, 95\% CI: −8.96; −2.49, I 2 = 89\%), and increase in TIR 70–180 mg/dL (WMCD 5.46, 95\% CI: 2.76; 8.16, I 2 = 69\%); (3) RT-CGM/DiP: CGM was superior to BGM for TIR 63–140 mg/dL (WMCD: 17.77, 95\% CI: 4.17; 31.36, I 2 = 92\%). No benefit was shown for HbA1c, TBR {\textless} 63 mg/dL, TAR {\textgreater} 140 mg/dL, and most of the maternal and neonatal outcomes of interest; (4) Non-RT CGM: HbA1c significantly decreased with non-RT CGM compared with BGM in T2D (WMCD −0.35, 95\% CI: −0.5; −0.2, I 2 = 19\%).Discussion:In T1D and T2D, RT-CGM decreased HbA1c and increased time in target range for glycemia (70–180 mg/dL) while decreasing time spent in hypoglycemia (T1D) and time in hyperglycemia (T1D, T2D).},
	language = {EN},
	number = {7},
	urldate = {2026-05-20},
	journal = {Diabetes Technology \& Therapeutics},
	publisher = {SAGE Publications},
	author = {Rizos, Evangelos C. and Markozannes, Georgios and Charitakis, Nikolaos and Filis, Panagiotis and Stoimeni, Anastasia E. and Nørgaard, Kirsten and Ntzani, Evangelia E. and Tsilidis, Konstantinos K.},
	month = jul,
	year = {2025},
	pages = {537--552},
}
































